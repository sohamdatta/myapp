    "check:report": "playwright show-report feature-check-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "mailparser": "^3.14.1",
    "monocart-coverage-reports": "^3.2.0",
    "smtp-server": "^3.21.3"
  }
}
