# DOMAIN is the address people open, such as hr.example.com. Caddy fetches and renews
# its HTTPS certificate from Let's Encrypt; port 80 and 443 must be open to the internet.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The API. Documents are up to 10 MB; the employee import file up to 5 MB.
	# Caddy replaces any X-Forwarded-For the browser sends with the address it sees, so the
	# backend (APP_TRUST_FORWARDED_FOR=true) gets the user's real address for the
	# office-network punch check.
	handle /api/* {
		request_body {
			max_size 11MB
		}
		reverse_proxy app:8080
	}

	# The frontend: built files, and index.html for anything else.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
