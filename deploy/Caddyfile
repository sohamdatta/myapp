# DOMAIN is the address people open, such as hr.example.com. Caddy fetches and renews
# its HTTPS certificate from Let's Encrypt; port 80 and 443 must be open to the internet.
{$DOMAIN} {
	encode zstd gzip

	# One JSON line per request, to the container log, which deploy/logs/ship-logs.sh sends daily to the
	# Indian-region log bucket (CERT-In: keep logs 180 days, inside India). Caddy leaves out the
	# Authorization and Cookie headers; the invitation token in a link's query is blanked too.
	log {
		output stdout
		format filter {
			request>uri query {
				replace invite REDACTED
				replace token REDACTED
			}
			wrap json
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		# What a page of the app may load: its own files only. A script injected into a page (the session token is
		# in the browser's storage) is then not run, and cannot send anything to another address. Styles allow
		# inline ones, which the screens set on elements; pictures and viewed documents come as data: and blob:.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# The punch screen asks where the person is; nothing uses the camera, microphone or payment.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		-Server
	}

	# Browser crash reports are short; anything larger is not one.
	handle /api/client-errors {
		request_body {
			max_size 8KB
		}
		reverse_proxy app:8080
	}

	# The API. Documents are up to 10 MB; the employee import file up to 5 MB.
	# Caddy replaces any X-Forwarded-For the browser sends with the address it sees, so the
	# backend (APP_TRUST_FORWARDED_FOR=true) gets the user's real address for the
	# office-network punch check.
	handle /api/* {
		request_body {
			max_size 11MB
		}
		reverse_proxy app:8080
	}

	# Biometric devices (eSSL / ZKTeco cloud push) that can use HTTPS send punches here.
	handle /iclock/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy app:8080
	}

	# The frontend: built files, and index.html for anything else (so /my-leave and other
	# page addresses open the app). Files under /assets have a content hash in their names, so
	# browsers keep them for a year; index.html is checked on every visit, so a new version is
	# picked up at once.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/* /api/* /iclock/*
	header @page Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Many biometric devices cannot use HTTPS. They send punches over plain HTTP to this port
# (8081 unless DEVICE_PORT says otherwise), which answers nothing but the device protocol.
# A device names itself by its serial number, which HR registers; a location with office
# network addresses takes punches only from those addresses.
http://:{$DEVICE_PORT:8081} {
	handle /iclock/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy app:8080
	}
	handle {
		respond 404
	}
}
