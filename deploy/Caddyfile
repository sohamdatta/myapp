# DOMAIN is the address people open, such as hr.example.com. Caddy fetches and renews
# its HTTPS certificate from Let's Encrypt; port 80 and 443 must be open to the internet.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The API. Documents are up to 10 MB; the employee import file up to 5 MB.
	# Caddy replaces any X-Forwarded-For the browser sends with the address it sees, so the
	# backend (APP_TRUST_FORWARDED_FOR=true) gets the user's real address for the
	# office-network punch check.
	handle /api/* {
		request_body {
			max_size 11MB
		}
		reverse_proxy app:8080
	}

	# Biometric devices (eSSL / ZKTeco cloud push) that can use HTTPS send punches here.
	handle /iclock/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy app:8080
	}

	# The frontend: built files, and index.html for anything else (so /my-leave and other
	# page addresses open the app). Files under /assets have a content hash in their names, so
	# browsers keep them for a year; index.html is checked on every visit, so a new version is
	# picked up at once.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/* /api/* /iclock/*
	header @page Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Many biometric devices cannot use HTTPS. They send punches over plain HTTP to this port
# (8081 unless DEVICE_PORT says otherwise), which answers nothing but the device protocol.
# A device names itself by its serial number, which HR registers; a location with office
# network addresses takes punches only from those addresses.
http://:{$DEVICE_PORT:8081} {
	handle /iclock/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy app:8080
	}
	handle {
		respond 404
	}
}
