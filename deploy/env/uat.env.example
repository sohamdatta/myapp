# Demo / UAT (Oracle Cloud) settings. On the UAT server only:
#   cp deploy/env/uat.env.example deploy/env/uat.env
#   chmod 600 deploy/env/uat.env
# then fill it in. Never commit the filled-in file. Run with: deploy/hrms.sh uat ...
# Guide: docs/deploy/oracle-cloud-uat.md
#
# Values of its own, never production's: another APP_DATA_KEY, other passwords.

# Which environment this file is for; deploy/hrms.sh refuses a file used for the wrong one.
HRMS_ENVIRONMENT=uat

# The address people open, such as uat.hr.example.com. Point its DNS A record at the server first.
DOMAIN=uat.hr.example.com

# Biometric devices that cannot use HTTPS send punches to this port. Usually not needed on UAT.
DEVICE_PORT=8081

# The PostgreSQL 16 on this same server (the "db" service). No SSL: it never leaves Docker's network.
APP_DB_URL=jdbc:postgresql://db:5432/hrms
APP_DB_OWNER_USER=dbmasteruser
# Make each with: openssl rand -base64 24
APP_DB_OWNER_PASSWORD=
APP_DB_ROLE_PASSWORD=
# The database's superuser (postgres). Only the backup uses it.
DB_SUPERUSER_PASSWORD=

# The first Super Admin, created on the first start only.
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_PASSWORD=

# Encrypts PAN, bank details and documents. Make one: openssl rand -base64 32
# A different key from production's. Keep a copy apart from the backups.
APP_DATA_KEY=
APP_REQUIRE_DATA_KEY=true

# Caddy sits in front and sets X-Forwarded-For.
APP_TRUST_FORWARDED_FOR=true

# Nightly backup. The time is UTC (21:30 UTC is 03:00 in India).
BACKUP_DIR=/srv/hrms-backups
BACKUP_AT_UTC=21:30
BACKUP_KEEP_DAYS=14

# Optional: also copy each backup to an OCI Object Storage bucket (see the guide, step 6).
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-mumbai-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Mail (reset links, undo links). Leave APP_SMTP_HOST empty and mail waits in the outbox; the platform console's
# Email page shows what is queued or failed. SECURITY is starttls (port 587), ssl (port 465) or none.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_SECURITY=starttls
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=

# The address put in the links in email. Leave it out and DOMAIN is used.
# APP_PUBLIC_URL=https://hrms.example.com
