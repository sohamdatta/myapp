# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.

# The address people open. Point its DNS A record at the server first.
DOMAIN=hr.example.com

# Biometric devices that cannot use HTTPS send punches over plain HTTP to this port
# (only /iclock is answered there). Open it in the server's firewall if you use one.
DEVICE_PORT=8081

# The managed PostgreSQL 16 database. sslmode=require: AWS refuses unencrypted connections.
APP_DB_URL=jdbc:postgresql://<database-endpoint>:5432/hrms?sslmode=require
# The database's admin login (Lightsail calls it the master user). It runs the migrations
# at startup and creates the app's own three database roles.
APP_DB_OWNER_USER=dbmasteruser
APP_DB_OWNER_PASSWORD=
# The password the app's three roles get. Make one: openssl rand -base64 24
APP_DB_ROLE_PASSWORD=

# The first Super Admin, created on the first start only.
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_PASSWORD=

# Encrypts PAN, bank details and documents. Make one: openssl rand -base64 32
# Keep a copy somewhere safe and apart from the database backups: lose it and that
# data can never be read again.
APP_DATA_KEY=
APP_REQUIRE_DATA_KEY=true

# Caddy sits in front and sets X-Forwarded-For.
APP_TRUST_FORWARDED_FOR=true
